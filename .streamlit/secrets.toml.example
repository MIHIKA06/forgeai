# Hosted deployment settings (Streamlit Community Cloud -> app -> Settings -> Secrets).
# Paste these four lines there, replacing gsk_... with your own Groq key.
# Never commit a real key to GitHub.
#
# Groq serves open models (Llama, Qwen) for free, so the hosted app needs no GPU.
# Model names change over time: see https://console.groq.com/docs/models
FORGE_BASE_URL = "https://api.groq.com/openai/v1"
FORGE_API_KEY = "gsk_your_key_here"
FORGE_MODEL = "qwen/qwen3.8-27b"
FORGE_JUDGE_MODEL = "openai/gpt-oss-20b"
