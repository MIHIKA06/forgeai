# Copy to .streamlit/secrets.toml (local) or paste into the hosting provider's "Secrets" panel.
# Any OpenAI-compatible endpoint works. Example: Groq free tier (open models, no GPU needed on the host).
FORGE_BASE_URL = "https://api.groq.com/openai/v1"
FORGE_API_KEY = "gsk_..."
FORGE_MODEL = "llama-3.1-8b-instant"
FORGE_JUDGE_MODEL = "gemma2-9b-it"
